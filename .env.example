# LiveKit Cloud (Projekt "StepSales")
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Agent-Variante je Deployment: gptlive | gemini
STEPSALES_VARIANT=
# Optional (Defaults im Code): STEPSALES_MODEL, STEPSALES_VOICE, STEPSALES_GPTLIVE_BACKEND_MODEL,
# STEPSALES_MAX_CALL_SECONDS (600), STEPSALES_TOOLS_TIMEOUT_S (8),
# STEPSALES_TEST_CALLS_ONLY (true bis zum Pilot)
# STEPSALES_WEB_TEST=true: Browser-Test ohne SIP/n8n (nie zusammen mit LIVEKIT_SIP_OUTBOUND_TRUNK_ID)
# Modelle laufen über LiveKit Inference – keine OpenAI/Google-Keys nötig

# n8n Agent-Tools-Webhook
N8N_TOOLS_WEBHOOK_URL=
N8N_TOOLS_WEBHOOK_SECRET=

# Langfuse
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
